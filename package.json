{
  "license": "MIT",
  "name": "@agentruntime/url-guard",
  "version": "0.1.0",
  "description": "Hardened SSRF guard — one implementation, Node builtins only. isPrivateUrl/isPrivateIp + assertUrlAllowed + fetchWithSsrfProtection + safeFetch.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "!dist/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.1"
  }
}
